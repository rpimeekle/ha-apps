; Generated at start-up from /etc/php84/templates/99-dokuwiki.ini.tmpl
[PHP]
expose_php = Off
display_errors = Off
log_errors = On
memory_limit = __MEMORY_LIMIT__M
upload_max_filesize = __UPLOAD_LIMIT__M
post_max_size = __POST_LIMIT__M
max_execution_time = 120
max_input_time = 120
max_input_vars = 5000
output_buffering = 4096

[Date]
date.timezone = "__TIMEZONE__"

[opcache]
opcache.enable = 1
opcache.memory_consumption = 64
opcache.interned_strings_buffer = 8
opcache.max_accelerated_files = 10000
opcache.validate_timestamps = 1
opcache.revalidate_freq = 2
